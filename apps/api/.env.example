# PORT=4000
# NODE_ENV=development

# # PostgreSQL (Orders, Payments, Inventory - Strong Consistency)
# POSTGRES_USER=forksquare
# POSTGRES_PASSWORD=forksquare_secret
# POSTGRES_DB=forksquare_orders
# DATABASE_URL=postgresql://forksquare:forksquare_secret@localhost:5432/forksquare_orders

# # MongoDB (Restaurants, Menus - Eventual Consistency)
# MONGO_URI=mongodb://localhost:27017/forksquare_menus

# # Redis (Cache, Locks, Bloom Filters)
# REDIS_HOST=localhost
# REDIS_PORT=6379





NODE_ENV=development
PORT=4000

JWT_SECRET=your_access_secret_min_32_chars
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=your_cookie_secret

POSTGRES_USER=forksquare
POSTGRES_PASSWORD=change_me
POSTGRES_DB=forksquare_orders
DATABASE_URL=postgresql://user:pass@localhost:5432/forksquare_orders

# PostgreSQL Standby (Read Replica) — Phase 1
DATABASE_REPLICA_URL=postgresql://forksquare:forksquare_secret@localhost:5433/forksquare_orders

MONGO_URI=mongodb://localhost:27017/forksquare_menus

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BROKERS=localhost:19092

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info